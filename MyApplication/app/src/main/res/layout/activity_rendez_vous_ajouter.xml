<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#e3f2fe"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Titre -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajouter un Rendez-vous"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#003366"
            android:layout_marginBottom="15dp"/>

        <!-- Champ Horaire -->
        <EditText
            android:id="@+id/et_horaire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/edit_text"
            android:hint="Horaire (ex: 14:00)"
            android:inputType="time"
            android:padding="12dp" />

        <!-- Champ Adresse -->
        <EditText
            android:id="@+id/et_adresse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/edit_text"
            android:hint="Adresse"
            android:padding="12dp" />

        <!-- Champ Nom du Docteur -->
        <EditText
            android:id="@+id/et_nom_docteur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/edit_text"
            android:hint="Nom du docteur"
            android:padding="12dp" />

        <!-- Champ Spécialité -->
        <EditText
            android:id="@+id/et_specialite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/edit_text"
            android:hint="Spécialité"
            android:padding="12dp" />

        <!-- Champ Notes (optionnel) -->
        <EditText
            android:id="@+id/et_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Notes"
            android:padding="12dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="10dp"/>

        <!-- Bouton Ajouter Rendez-vous -->
        <Button
            android:id="@+id/btn_ajouter_rdv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            android:background="@drawable/button_background"
            android:backgroundTint="#003366"
            android:padding="12dp"
            android:text="Ajouter Rendez-vous"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>